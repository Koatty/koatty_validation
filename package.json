{
  "name": "koatty_validation",
  "version": "4.0.0",
  "description": "Validation Util for Koatty and ThinkORM.",
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:dts && pnpm run build:doc && pnpm run build:cp",
    "build:js": "tsup",
    "build:dts": "bash ../../scripts/build-dts.sh && tsc src/schema-rules.ts --declaration --emitDeclarationOnly --skipLibCheck --target ES2020 --module commonjs --outDir dist",
    "build:doc": "api-documenter markdown --input temp --output docs/api",
    "build:cp": "node ../../scripts/postBuild.js && cp temp/schema-rules.d.ts dist/schema-rules.d.ts",
    "clean": "rimraf dist temp docs/api",
    "lint": "eslint --ext .ts,.js ./src",
    "test": "pnpm run lint && jest --passWithNoTests",
    "test:cov": "jest --collectCoverage --detectOpenHandles"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema-rules": {
      "types": "./dist/schema-rules.d.ts",
      "import": "./dist/schema-rules.mjs",
      "require": "./dist/schema-rules.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koatty/koatty_validation.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "richenlin",
    "email": "richenlin@gmail.com"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/koatty/koatty_validation/issues"
  },
  "homepage": "https://github.com/koatty/koatty_validation",
  "maintainers": [
    {
      "name": "richenlin",
      "email": "richenlin@gmail.com"
    }
  ],
  "devDependencies": {
    "@microsoft/api-documenter": "^7.26.x",
    "@microsoft/api-extractor": "^7.52.x",
    "@types/jest": "^29.5.x",
    "@types/koa": "^2.x.x",
    "@types/lodash": "^4.x.x",
    "@types/node": "^22.x.x",
    "@types/validator": "^13.x.x",
    "@typescript-eslint/eslint-plugin": "^8.x.x",
    "@typescript-eslint/parser": "^8.x.x",
    "eslint": "^8.x.x",
    "eslint-plugin-jest": "^28.x.x",
    "jest": "^29.x.x",
    "jest-html-reporters": "^3.x.x",
    "libphonenumber-js": "^1.x.x",
    "ts-jest": "^29.x.x",
    "tslib": "^2.x.x"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "koatty_container": "workspace:*",
    "koatty_lib": "workspace:*",
    "koatty_logger": "workspace:*",
    "lru-cache": "^11.2.5",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "koatty_container": "^4.0.0",
    "koatty_lib": "^1.6.0",
    "koatty_logger": "^3.1.0"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "schema-rules": [
        "dist/schema-rules.d.ts"
      ]
    }
  }
}
